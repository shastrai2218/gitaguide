# Base URL for the API. Leave as /api to use the Vite dev proxy (recommended);
# set an absolute origin when the UI is served separately from the backend.
VITE_API_BASE=/api

# Show the explainability meta line under each assistant turn. Set to 0 to hide.
VITE_SHOW_META=1

# UI-preview mode: canned responses, no backend, no model. Always renders a
# visible MOCK badge in the header. Never set this in anything a tester uses.
# Keywords "crisis-test" and "slow-test" preview those states.
# VITE_MOCK=1

# Optional accounts (Clerk). Leave unset and the app works exactly as it does
# without this section: anonymous sessions, chats saved to this browser only,
# no sign-in UI anywhere. Set it to turn that on - get the value from the
# Clerk dashboard -> your application -> API Keys -> "Publishable key". It is
# meant to be public (it ships in the bundle), so there is no secret half of
# this on the frontend; the backend verifies tokens against Clerk's published
# signing keys, not this value. See GITAGUIDE_CLERK_ISSUER in the backend's
# .env.example - both must point at the same Clerk application.
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
