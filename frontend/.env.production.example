# ---------------------------------------------------------------------------
# GitaGuide frontend - production environment (PLACEHOLDERS ONLY)
#
# Set these NAMES in the Vercel dashboard (Project → Settings → Environment
# Variables), scoped to Production. Vite inlines VITE_* values at build time, so
# changing one requires a redeploy, not just a restart.
#
# There are no secrets here and there must never be: anything prefixed VITE_ is
# compiled into the bundle and is readable by anyone who opens devtools.
# ---------------------------------------------------------------------------

# The Render API origin, including the /api prefix. Required.
#
# There is no sensible default: the relative "/api" works behind the Vite dev
# proxy and 404s on Vercel, so the build FAILS if this is unset on Vercel
# rather than shipping a UI where every turn silently fails.
VITE_API_BASE=https://REPLACE_ME.onrender.com/api

# Explainability meta line under each assistant turn (emotion, intent, memory,
# model, per-stage latency). Kept ON for the beta - the whole point of the
# closed group is that they can tell you what the pipeline did.
VITE_SHOW_META=1

# VITE_MOCK must be ABSENT or 0 in production.
#
# It serves canned answers with no backend and no model. The build refuses to
# run with VITE_MOCK=1 in production mode, so this is enforced rather than
# merely documented - but do not set it here at all.
# VITE_MOCK=0
