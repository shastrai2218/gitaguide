# ---------------------------------------------------------------------------
# GitaGuide - production environment template (PLACEHOLDERS ONLY)
#
# Copy the NAMES from here into the Render dashboard and fill in the values
# there. Do not commit a filled-in copy of this file: .env is gitignored,
# .env.production.example is not, because it is meant to be read.
#
# Every value below is either a placeholder or a real default. There is no
# credential in this file and there must never be one.
#
# The variables are grouped by what happens if you get them wrong, because that
# is the useful ordering when something is broken at 11pm.
# ---------------------------------------------------------------------------


# === Gets you a service that looks fine and helps nobody =====================

# The single most consequential variable. `true` runs the whole pipeline on
# in-process fakes: /health returns 200, answers arrive with citations, and
# every one of them is canned. Must be false in production.
GITAGUIDE_MOCK_MODE=false

GITAGUIDE_ENVIRONMENT=prod
GITAGUIDE_LOG_LEVEL=INFO


# === Secrets: set in the Render dashboard, never here ========================

# NVIDIA NIM key from build.nvidia.com. Starts with nvapi-.
NVIDIA_API_KEY=nvapi-REPLACE_ME

# Supabase pooled connection string, rewritten for asyncpg. Note the driver
# prefix and that sslmode is NOT a query parameter for asyncpg - see
# docs/DEPLOY.md, which gives the exact transformation from what Supabase shows.
GITAGUIDE_POSTGRES_DSN=postgresql+asyncpg://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Neo4j AuraDB. The URI is the neo4j+s:// form from the Aura console.
GITAGUIDE_NEO4J_URI=neo4j+s://REPLACE_ME.databases.neo4j.io
GITAGUIDE_NEO4J_PASSWORD=REPLACE_ME

# Salt for the telemetry session pseudonym. Any long random string. Changing it
# makes old and new telemetry ungroupable, which is the intended trade-off, so
# set it once and leave it.
GITAGUIDE_TELEMETRY_SESSION_SALT=REPLACE_ME_WITH_A_LONG_RANDOM_STRING


# === Backends ================================================================

GITAGUIDE_USE_REAL_NEO4J=true
GITAGUIDE_NEO4J_USERNAME=neo4j
GITAGUIDE_NEO4J_DATABASE=neo4j
GITAGUIDE_NEO4J_VECTOR_INDEX=verseEmbeddingIndex
GITAGUIDE_NEO4J_FULLTEXT_INDEX=verseTextIndex

GITAGUIDE_LLM_PROVIDER=nvidia
GITAGUIDE_NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
GITAGUIDE_NVIDIA_FALLBACK_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b


# === Limits: explicit in production, not inherited from code defaults ========
#
# These are written out even where they match the defaults, so that reading the
# Render dashboard tells you what the deployment actually enforces. A limit you
# have to go and read the source to discover is a limit nobody checks.
#
# Sizing (see app/api/ratelimit.py): one normal turn costs two calls on the
# primary NIM model, ~2.05 with the malformed-intent retry, against a ~40
# req/min per-model free tier. That is a ceiling near 19 turns/min for the whole
# deployment.
#
# Per-session and per-IP limits do NOT bound that. Twenty testers each under
# 5/min is 100 turns/min. The global bucket is the one protecting the budget.

GITAGUIDE_RATE_LIMIT_ENABLED=true

# Per session: comfortable for a person thinking between messages.
GITAGUIDE_RATE_LIMIT_SESSION_PER_MINUTE=5
GITAGUIDE_RATE_LIMIT_SESSION_BURST=3

# Per IP: well above the session limit, because testers behind one office NAT
# share an address and must not rate-limit each other.
GITAGUIDE_RATE_LIMIT_IP_PER_MINUTE=20
GITAGUIDE_RATE_LIMIT_IP_BURST=8

# Global: 16/min against a ~19/min ceiling, leaving headroom for retries and
# the occasional summary call. With ~20 testers this is roughly 0.8 turns/min
# each sustained. That is what the free tier supports; raising it does not buy
# capacity, it buys 429s from NVIDIA instead of from us.
GITAGUIDE_RATE_LIMIT_GLOBAL_PER_MINUTE=16
GITAGUIDE_RATE_LIMIT_GLOBAL_BURST=6

# Total wall clock for one turn's generation, across the whole provider chain.
# MUST be >= 15: the app refuses to boot below that, because the intent
# classifier shares this budget and a small value silently starves the semantic
# half of the crisis gate.
GITAGUIDE_GENERATION_BUDGET_SECONDS=45


# === Consent and telemetry ===================================================

# Server-side consent enforcement. Never false in anything a tester touches:
# with it off, /api/chat serves sessions that never agreed to anything and the
# consent record is worthless.
GITAGUIDE_CONSENT_REQUIRED=true
GITAGUIDE_CONSENT_VERSION=v1

GITAGUIDE_TELEMETRY_ENABLED=true
GITAGUIDE_TELEMETRY_PATH=/app/logs/telemetry.jsonl
GITAGUIDE_TELEMETRY_MAX_BYTES=10000000
GITAGUIDE_TELEMETRY_BACKUP_COUNT=5


# === Frontend origin =========================================================
#
# Comma-separated. Set this after the Vercel deployment exists (DEPLOY.md step
# 4). Until then the browser will be refused by CORS, which is the correct
# failure - it is visible, and it does not leave the API open to any origin.
GITAGUIDE_CORS_ORIGINS=https://REPLACE_ME.vercel.app


# === Safety and memory: do not change without a measurement ==================
#
# Listed so the deployment is self-describing, but these are the numbers the
# evaluation in docs/kg_measurements.md was produced against. Changing one
# invalidates that evidence.
GITAGUIDE_SAFETY_CRISIS_INTENT_THRESHOLD=0.5
GITAGUIDE_SAFETY_LOG_ENABLED=true
GITAGUIDE_MEMORY_LAST_N_TURNS=6
GITAGUIDE_MEMORY_SUMMARY_TRIGGER_TURNS=8
