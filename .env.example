# ---------------------------------------------------------------------------
# GitaGuide configuration. Copy to .env and edit. NEVER commit .env.
# All variables are prefixed GITAGUIDE_ and read by app/config.py.
# ---------------------------------------------------------------------------

# ---- runtime --------------------------------------------------------------
GITAGUIDE_ENVIRONMENT=dev
GITAGUIDE_LOG_LEVEL=INFO

# Master offline switch. true  -> in-process fakes for Neo4j, Postgres and the
# LLM (no credentials needed at all). false -> use the services below.
GITAGUIDE_MOCK_MODE=true

# Fine-grained overrides. Leave unset to follow MOCK_MODE.
# GITAGUIDE_USE_REAL_NEO4J=true
# GITAGUIDE_USE_REAL_POSTGRES=true
# GITAGUIDE_USE_REAL_EMOTION_MODEL=true

# ---- Neo4j AuraDB ---------------------------------------------------------
GITAGUIDE_NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
GITAGUIDE_NEO4J_USERNAME=neo4j
GITAGUIDE_NEO4J_PASSWORD=
GITAGUIDE_NEO4J_DATABASE=neo4j
GITAGUIDE_NEO4J_VECTOR_INDEX=verseEmbeddingIndex
GITAGUIDE_NEO4J_FULLTEXT_INDEX=verseTextIndex

# ---- PostgreSQL -----------------------------------------------------------
GITAGUIDE_POSTGRES_DSN=postgresql+asyncpg://gitaguide:gitaguide@localhost:5432/gitaguide

# ---- models ---------------------------------------------------------------
GITAGUIDE_EMOTION_MODEL_ID=SamLowe/roberta-base-go_emotions
GITAGUIDE_EMOTION_ONNX_REPO=SamLowe/roberta-base-go_emotions-onnx
GITAGUIDE_EMOTION_ONNX_FILE=onnx/model_quantized.onnx
GITAGUIDE_EMOTION_TOP_K=5
GITAGUIDE_ONNX_INTRA_OP_THREADS=2
GITAGUIDE_EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
GITAGUIDE_EMBEDDING_DIM=384

# ---- LLM ------------------------------------------------------------------
# nvidia | anthropic | openai | fake
# With MOCK_MODE=false and an NVIDIA key present, NIM is used even if this says
# fake - see Settings.resolved_llm_provider.
GITAGUIDE_LLM_PROVIDER=nvidia
# Optional non-NIM provider inserted before the fake at the end of the chain.
# GITAGUIDE_LLM_FALLBACK_PROVIDER=openai
GITAGUIDE_LLM_MAX_TOKENS=1200
GITAGUIDE_LLM_TEMPERATURE=0.6

# ---- NVIDIA NIM (build.nvidia.com) ---------------------------------------
# Get a key at https://build.nvidia.com -> pick a model -> "Get API Key".
# It starts with "nvapi-". The unprefixed NVIDIA_API_KEY name is accepted
# because that is what NVIDIA hands out; GITAGUIDE_NVIDIA_API_KEY also works.
# Keep it in .env only - it must never appear in code, README or tests.
NVIDIA_API_KEY=
GITAGUIDE_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Slugs verified against GET /v1/models (that endpoint needs no auth).
GITAGUIDE_NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
# A different model = a different rate-limit bucket. Alternative:
# deepseek-ai/deepseek-v4-flash-0731
GITAGUIDE_NVIDIA_FALLBACK_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
GITAGUIDE_NVIDIA_TEMPERATURE=0.6
GITAGUIDE_NVIDIA_MAX_TOKENS=1200
GITAGUIDE_NVIDIA_INTENT_MAX_TOKENS=128
# Nemotron 3 is a hybrid reasoning model; keep the trace out of chat answers.
GITAGUIDE_NVIDIA_DISABLE_THINKING=true
GITAGUIDE_NVIDIA_THINKING_DIRECTIVE=/no_think
# Free tier is ~40 requests/minute per model and 429s on burst. These retries
# happen inside the provider, before failover moves to the next model.
GITAGUIDE_NVIDIA_MAX_RETRIES=3
GITAGUIDE_NVIDIA_RETRY_BASE_DELAY=1.0
GITAGUIDE_NVIDIA_RETRY_MAX_DELAY=20.0

# ---- other LLM providers (optional) ---------------------------------------
GITAGUIDE_ANTHROPIC_API_KEY=
GITAGUIDE_ANTHROPIC_MODEL=claude-sonnet-5
GITAGUIDE_OPENAI_API_KEY=
GITAGUIDE_OPENAI_MODEL=gpt-4o-mini

# ---- retrieval ------------------------------------------------------------
GITAGUIDE_RETRIEVAL_TOP_K=5
GITAGUIDE_RETRIEVAL_CANDIDATE_K=20
GITAGUIDE_GRAPH_EXPANSION_HOPS=2
GITAGUIDE_SCRIPTURE_INTENT_BOOST=0.25
GITAGUIDE_GRAPH_PATH_BOOST=0.15

# ---- safety ---------------------------------------------------------------
# Emotion intensity at or above which grief/fear alone trips the gate.
GITAGUIDE_SAFETY_INTENSITY_THRESHOLD=0.85
GITAGUIDE_SAFETY_CRISIS_INTENT_THRESHOLD=0.5
GITAGUIDE_SAFETY_LOG_ENABLED=true

# ---- memory ---------------------------------------------------------------
GITAGUIDE_MEMORY_LAST_N_TURNS=6
GITAGUIDE_MEMORY_SUMMARY_TRIGGER_TURNS=8

# ---- api ------------------------------------------------------------------
GITAGUIDE_CORS_ORIGINS=http://localhost:5173,http://localhost:4173
