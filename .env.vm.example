# ---------------------------------------------------------------------------
# GitaGuide on a single VM (AWS EC2) - environment template (PLACEHOLDERS ONLY)
#
# On the VM:   cp .env.vm.example .env.vm && chmod 600 .env.vm
# then fill in the REPLACE_ME values. .env.vm is gitignored; this file is
# not, so nothing in it may ever be a real credential.
#
# Values are read by compose (variable substitution) and passed to the API
# container. Do NOT wrap them in quotes: compose passes quotes through literally
# in an env file, and a quoted DSN or origin stops matching.
#
# This file is the source of truth for what the deployment enforces, and
# tests/test_deploy_config.py holds it to the invariants the code depends on
# (INT8 with serialised turns, one proxy hop, a JSON-list CORS origin, the
# session pooler). Change a deployed value here first, so the tests see it.
# ---------------------------------------------------------------------------

# === VM-specific =============================================================

# A hostname that already resolves to the VM's public IP (the Elastic IP on AWS).
# For IP 13.233.10.20 the zero-setup choice is 13-233-10-20.sslip.io (dashes, not
# dots, then .sslip.io). A DuckDNS name or your own domain also works. Avoid the
# ec2-*.amazonaws.com name: it is a shared domain you do not control, and Let's
# Encrypt's per-domain rate limits can block issuing a certificate for it.
# Bare hostname: no https://, no trailing slash.
API_DOMAIN=REPLACE_ME.sslip.io

# Exactly one proxy (Caddy) sits in front of the API. At 0 the per-IP limit keys
# on Caddy's container address and collapses into a second global bucket; above
# 1 a client can pick its own bucket by forging X-Forwarded-For.
GITAGUIDE_RATE_LIMIT_TRUSTED_PROXY_HOPS=1

# The deployed Vercel origin. Exact, https, no trailing slash. A JSON list, not a
# comma-separated string: the app fails to boot on `a,b` here, because
# pydantic-settings tries to parse a list field as JSON first. Add a second
# origin (a preview or custom domain) as another element of the list.
GITAGUIDE_CORS_ORIGINS=["https://gitaguide-neon.vercel.app"]


# === Secrets: from the provider dashboards, never committed ===================

NVIDIA_API_KEY=nvapi-REPLACE_ME

# Supabase SESSION pooler (port 5432), driver rewritten to asyncpg, and NO
# ?sslmode=require. Not the transaction pooler (6543): this app's engine uses
# prepared statements, which fail there under concurrency. Not the direct
# db.<ref>.supabase.co host either: it is IPv6-only and unreachable from EC2.
# Percent-encode special characters in the password (# becomes %23).
# See docs/DEPLOY_AWS.md step 6.
GITAGUIDE_POSTGRES_DSN=postgresql+asyncpg://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Neo4j AuraDB. On Aura Free the username AND the database name are the
# instance id, not "neo4j".
GITAGUIDE_NEO4J_URI=neo4j+s://REPLACE_ME.databases.neo4j.io
GITAGUIDE_NEO4J_USERNAME=REPLACE_ME_INSTANCE_ID
GITAGUIDE_NEO4J_DATABASE=REPLACE_ME_INSTANCE_ID
GITAGUIDE_NEO4J_PASSWORD=REPLACE_ME

# Any long random string, set once (for example `openssl rand -hex 32`).
# Changing it makes old and new telemetry ungroupable. With
# GITAGUIDE_ENVIRONMENT=prod the API REFUSES TO START while this is unset, still
# the placeholder below, or the code default: on any of those the session
# pseudonyms in telemetry are reversible by anyone who knows a session id.
GITAGUIDE_TELEMETRY_SESSION_SALT=REPLACE_ME_WITH_A_LONG_RANDOM_STRING

# Optional accounts (docs/DEPLOY.md step 4b). Leave unset to keep the beta
# anonymous-only. Must name the same Clerk application as the frontend's
# VITE_CLERK_PUBLISHABLE_KEY.
# GITAGUIDE_CLERK_ISSUER=https://your-app.clerk.accounts.dev


# === Mode: `true` serves canned answers while /health looks fine ==============

GITAGUIDE_ENVIRONMENT=prod
GITAGUIDE_LOG_LEVEL=INFO
GITAGUIDE_MOCK_MODE=false


# === Models ==================================================================
#
# int8 because the graph in Aura was embedded with the int8 encoder. The stored
# vectors and the query encoder are one decision: switching this without
# re-embedding and re-importing the graph does not error, it quietly returns
# worse neighbours. Keep int8 on every shape, including a larger one.
GITAGUIDE_EMBEDDER_PRECISION=int8
GITAGUIDE_ONNX_INTRA_OP_THREADS=1
# One turn at a time. A turn peaks near 430 MiB, which is most of a 1 GB
# t3.micro and comfortable on a 2 GB t3.small; serialising is what keeps two of
# them from meeting. On a larger instance this could be relaxed, but the rate
# limiter and telemetry are still in-process, so leave it until there is a
# measurement to justify changing it.
GITAGUIDE_PIPELINE_SERIALISE=true
GITAGUIDE_PIPELINE_QUEUE_TIMEOUT_SECONDS=30

GITAGUIDE_USE_REAL_NEO4J=true
GITAGUIDE_LLM_PROVIDER=nvidia


# === Limits: sized against the ~40 req/min NIM free tier ======================

GITAGUIDE_RATE_LIMIT_ENABLED=true
GITAGUIDE_RATE_LIMIT_SESSION_PER_MINUTE=5
GITAGUIDE_RATE_LIMIT_SESSION_BURST=3
GITAGUIDE_RATE_LIMIT_IP_PER_MINUTE=20
GITAGUIDE_RATE_LIMIT_IP_BURST=8
GITAGUIDE_RATE_LIMIT_GLOBAL_PER_MINUTE=16
GITAGUIDE_RATE_LIMIT_GLOBAL_BURST=6

# Must be >= 15 or the app refuses to boot.
GITAGUIDE_GENERATION_BUDGET_SECONDS=45


# === Conversational router ===================================================

GITAGUIDE_ROUTER_MODEL_ENABLED=true
GITAGUIDE_ROUTER_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
GITAGUIDE_ROUTER_TIMEOUT_SECONDS=6
GITAGUIDE_ROUTER_MAX_TOKENS=160
GITAGUIDE_QUERY_REWRITE=on


# === Consent and telemetry ===================================================

GITAGUIDE_CONSENT_REQUIRED=true
GITAGUIDE_CONSENT_VERSION=beta-1
GITAGUIDE_TELEMETRY_ENABLED=true
GITAGUIDE_TELEMETRY_PATH=/app/logs/telemetry.jsonl
